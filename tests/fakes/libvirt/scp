#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
set -eu
while [ "$#" -gt 2 ]; do
	shift
done
source=${1#*:}
destination=$2
case "$source" in
/var/lib/uib/results/*)
	name=${source#/var/lib/uib/results/}
	mapped=$LIBVIRT_REMOTE_ROOT/results/$name
	if [ -d "$mapped" ]; then
		mkdir "$destination"
		cp -R "$mapped/." "$destination/"
	else
		cp "$mapped" "$destination"
	fi
	;;
*)
	echo "unexpected remote path: $source" >&2
	exit 2
	;;
esac
