#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
set -eu
printf '%s\n' "$*" > "$LIBVIRT_TEST_LOG/ansible.args"
inventory=
playbook=
extra=
while [ "$#" -gt 0 ]; do
	case "$1" in
	-i)
		shift
		inventory=$1
		;;
	--extra-vars)
		shift
		extra=$1
		;;
	*.yaml)
		playbook=$1
		;;
	esac
	shift
done
[ -f "$inventory" ]
[ -f "$playbook" ]
case "$playbook" in
*site-kubernetes.yaml)
	grep -q '^    kubernetes_controller:' "$inventory"
	grep -q '^    kubernetes_workers:' "$inventory"
	;;
*site-slurm.yaml)
	grep -q '^    slurm_controller:' "$inventory"
	grep -q '^    slurm_workers:' "$inventory"
	;;
*)
	echo "unexpected playbook: $playbook" >&2
	exit 2
	;;
esac
extra=${extra#@}
[ -f "$extra" ]
python3 - "$extra" <<'PY'
import json
import pathlib
import sys


with open(sys.argv[1], encoding="utf-8") as source:
    values = json.load(source)
assert values["uib_run_id"] in (
    "uib-kubernetes-test", "uib-libvirt-test", "uib-libvirt-failed")
assert values["uib_enabled"] is True
assert values["uib_data_interface"] == "eth1"
assert values["uib_network_shaping"] == {"enabled": False}
assert values["uib_netem_source"].endswith("/simulation/network/netem")
assert values["uib_stage_image_source"].endswith(
    "/simulation/adapters/slurm/stage-image")
assert values["uib_node_cpu"] == 2
assert values["uib_node_memory_mib"] == 4096
state = pathlib.Path(values["uib_run_state"])
if values["uib_run_id"] == "uib-kubernetes-test":
    assert values["uib_cluster_group"] == "kubernetes_cluster"
    assert values["uib_k3s_version"] == "v1.35.5+k3s1"
    assert values["uib_k3s_url"].endswith("/v1.35.5%2Bk3s1/k3s")
    assert len(values["uib_k3s_token"]) == 64
    assert values["uib_kubernetes_pod_cidr"] == "10.42.0.0/16"
    assert values["uib_kubernetes_service_cidr"] == "10.43.0.0/16"
    assert "uib_slurm_partition" not in values
    (state / "kubeconfig").write_text(
        "apiVersion: v1\n"
        "clusters:\n"
        "- cluster:\n"
        "    certificate-authority-data: dGVzdA==\n"
        "    server: https://127.0.0.1:6443\n"
        "  name: default\n"
        "contexts: []\n"
        "current-context: default\n"
        "kind: Config\n"
        "preferences: {}\n"
        "users: []\n",
        encoding="utf-8")
else:
    assert values["uib_cluster_group"] == "slurm_cluster"
    assert values["uib_slurm_partition"] == "uib"
    assert len(values["uib_stack_downloads"]) == 3
(state / "network").mkdir()
for node in ("worker-01", "worker-02"):
    evidence = {
        "schemaVersion": 1,
        "node": node,
        "interface": values["uib_data_interface"],
        "shaping": values["uib_network_shaping"],
        "appliedCommand": "tc qdisc del dev eth1 root",
        "qdisc": "qdisc noqueue 0: root refcnt 2",
        "iproute2": "tc utility, iproute2-test",
        "kernel": "test-kernel",
    }
    with (state / "network" / f"{node}.json").open(
            "w", encoding="utf-8") as output:
        json.dump(evidence, output)
PY
