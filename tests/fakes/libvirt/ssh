#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
set -eu
command=
for argument in "$@"; do
	command=$argument
done
printf '%s\n' "$command" >> "$LIBVIRT_TEST_LOG/ssh.commands"
case "$command" in
'test -d /var/cache/uib/models'|'test -d /var/lib/uib/results'|\
'test -d /var/lib/uib/runtime'|\
'test -d /var/lib/uib/results/uib-libvirt-test')
	exit 0
	;;
'sudo -n /usr/local/libexec/uib-stage-image check aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa')
	image=$LIBVIRT_REMOTE_ROOT/images/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.sqsh
	[ -f "$image" ] || exit 3
	printf '%s\n' /var/cache/uib/images/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.sqsh
	;;
'sudo -n /usr/local/libexec/uib-stage-image import aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'|\
'sudo -n /usr/local/libexec/uib-stage-image install aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa')
	mkdir -p "$LIBVIRT_REMOTE_ROOT/images"
	cat > "$LIBVIRT_REMOTE_ROOT/images/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.sqsh"
	printf '%s\n' /var/cache/uib/images/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.sqsh
	;;
/usr/local/libexec/uib-stage-huggingface-cache\ check\ *)
	digest=${command##* }
	marker=$LIBVIRT_REMOTE_ROOT/models/huggingface/.uib-archive-sha256
	[ -f "$marker" ] || exit 3
	[ "$(cat "$marker")" = "$digest" ] || exit 4
	printf '%s\n' /var/cache/uib/models/huggingface
	;;
/usr/local/libexec/uib-stage-huggingface-cache\ install\ *)
	digest=${command##* }
	mkdir -p "$LIBVIRT_REMOTE_ROOT/models/huggingface"
	cat > "$LIBVIRT_REMOTE_ROOT/models/cache.tar"
	printf '%s\n' "$digest" \
		> "$LIBVIRT_REMOTE_ROOT/models/huggingface/.uib-archive-sha256"
	printf '%s\n' /var/cache/uib/models/huggingface
	;;
'sbatch --parsable')
	cat > "$LIBVIRT_TEST_LOG/submitted.sbatch"
	if [ "${REMOTE_SBATCH_FAIL:-0}" = 1 ]; then
		echo 'submission rejected' >&2
		exit 7
	fi
	echo '7654;uib-libvirt-test'
	;;
sacct\ *)
	echo 'Slurm accounting storage is disabled' >&2
	exit 1
	;;
'scontrol --oneliner show job 7654')
	echo 'JobId=7654 JobState=COMPLETED ExitCode=0:0 RunTime=00:00:19 NodeList=worker-[01-02]'
	;;
'find /var/lib/uib/results/uib-libvirt-test -type l -print -quit')
	exit 0
	;;

'find /var/lib/uib/results/uib-libvirt-test-7654.out -maxdepth 0 -type f -print -quit')
	echo '/var/lib/uib/results/uib-libvirt-test-7654.out'
	;;
'find /var/lib/uib/results/uib-libvirt-test-7654.err -maxdepth 0 -type f -print -quit')
	echo '/var/lib/uib/results/uib-libvirt-test-7654.err'
	;;
'scancel --quiet 7654')
	printf '%s\n' 7654 > "$LIBVIRT_TEST_LOG/scancel.job"
	;;
*)
	echo "unexpected remote command: $command" >&2
	exit 2
	;;
esac
