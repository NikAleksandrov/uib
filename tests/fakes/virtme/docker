#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
set -eu
case "$1 $2" in
'image inspect')
	printf '%s\n' 'sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
	;;
'image save')
	printf '%s\n' fake-oci-archive > "$4"
	;;
*)
	echo "unexpected container command: $*" >&2
	exit 2
	;;
esac
