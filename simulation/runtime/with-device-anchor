#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
set -eu

source_path=${DEVICE_ANCHOR_SOURCE:-/dev/null}
target_path=${DEVICE_ANCHOR_PATH:-/dev/infiniband/uib0}
target_dir=${target_path%/*}
created_dir=false
created_target=false
mounted=false

usage()
{
	echo "usage: $0 command [argument ...]" >&2
	exit 2
}

cleanup()
{
	status=$?
	trap - EXIT HUP INT TERM
	if [ "$mounted" = true ]; then
		umount "$target_path" || true
	fi
	if [ "$created_target" = true ]; then
		rm -f -- "$target_path"
	fi
	if [ "$created_dir" = true ]; then
		rmdir -- "$target_dir" 2>/dev/null || true
	fi
	exit "$status"
}

[ "$#" -gt 0 ] || usage
[ -c "$source_path" ] && [ -r "$source_path" ] && [ -w "$source_path" ] || {
	echo "UIB device-anchor source must be a readable and writable" \
		"character device: $source_path" >&2
	exit 2
}

if [ -e "$target_path" ] && [ ! -c "$target_path" ]; then
	echo "UIB device-anchor target exists but is not a character device:" \
		"$target_path" >&2
	exit 2
fi
if [ -c "$target_path" ]; then
	if [ ! -r "$target_path" ] || [ ! -w "$target_path" ]; then
		echo "UIB device-anchor target is not readable and writable:" \
			"$target_path" >&2
		exit 2
	fi
	exec "$@"
fi
if [ "$(id -u)" -ne 0 ]; then
	echo "creating $target_path requires mount privileges; run this wrapper" \
		"as root or use the documented container bind mount" >&2
	exit 2
fi

if [ ! -d "$target_dir" ]; then
	mkdir -p -- "$target_dir"
	created_dir=true
fi
: > "$target_path"
created_target=true
trap cleanup EXIT HUP INT TERM
mount --bind "$source_path" "$target_path"
mounted=true
"$@"
