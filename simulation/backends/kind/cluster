#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0

import argparse
import json
import os
import pathlib
import re
import shlex
import shutil
import subprocess
import sys
import tempfile

import yaml


NAME = re.compile(r"^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$")
DIGEST = re.compile(r"^\S+@sha256:[0-9a-f]{64}$")
DURATION = re.compile(r"^[1-9][0-9]*(?:s|m|h)$")
IMAGE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._/@:+-]*$")


class KindError(Exception):
    pass


def load_config(path):
    try:
        with pathlib.Path(path).open(encoding="utf-8") as source:
            config = json.load(source)
    except (OSError, json.JSONDecodeError) as error:
        raise KindError(f"cannot load {path}: {error}") from error

    if config.get("infrastructure", {}).get("provider") != "kind":
        raise KindError("configuration does not select the Kind provider")
    if config.get("cluster", {}).get("manager") != "kubernetes":
        raise KindError("Kind requires the Kubernetes cluster manager")
    if config.get("nodes", {}).get("controlPlane") != 1:
        raise KindError("the Kind backend requires one control-plane node")
    image = config.get("cluster", {}).get("nodeImage", "")
    if not DIGEST.fullmatch(image):
        raise KindError("cluster.nodeImage must use an @sha256 digest")
    return config


def kind_config(config):
    image = config["cluster"]["nodeImage"]
    nodes = [{"role": "control-plane", "image": image}]
    nodes.extend({"role": "worker", "image": image}
                 for _ in range(config["nodes"]["workers"]))
    return {
        "kind": "Cluster",
        "apiVersion": "kind.x-k8s.io/v1alpha4",
        "nodes": nodes,
    }


def validate_name(name):
    if not NAME.fullmatch(name):
        raise KindError(
            "cluster name must be a lowercase DNS label of at most 63 characters")


def validate_images(images, allow_mutable_tags):
    for image in images:
        if not IMAGE.fullmatch(image):
            raise KindError(f"invalid image reference: {image}")
        if "@sha256:" not in image and not allow_mutable_tags:
            raise KindError(
                f"image reference is not digest-pinned: {image}; "
                "use --allow-mutable-tags only for local development images")


def kind_command():
    command = os.environ.get("KIND_COMMAND", "kind")
    if os.path.sep not in command:
        resolved = shutil.which(command)
    else:
        resolved = command if os.access(command, os.X_OK) else None
    if not resolved:
        raise KindError(f"Kind command not found: {command}")
    return resolved


def run(command, capture=False):
    print(shlex.join(command), file=sys.stderr)
    try:
        return subprocess.run(command, check=True, text=True,
                              capture_output=capture)
    except subprocess.CalledProcessError as error:
        raise KindError(f"command failed with status {error.returncode}") from error


def command_render(args):
    config = load_config(args.config)
    print(yaml.safe_dump(kind_config(config), sort_keys=False), end="")


def command_up(args):
    validate_name(args.name)
    if not DURATION.fullmatch(args.wait):
        raise KindError("--wait must be a positive integer followed by s, m, or h")
    config = load_config(args.config)
    rendered = yaml.safe_dump(kind_config(config), sort_keys=False)
    with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8",
                                     prefix="uib-kind-", suffix=".yaml") as output:
        output.write(rendered)
        output.flush()
        command = [kind_command(), "create", "cluster", "--name", args.name,
                   "--config", output.name, "--wait", args.wait]
        if args.kubeconfig:
            command.extend(["--kubeconfig", args.kubeconfig])
        if args.retain:
            command.append("--retain")
        run(command)


def command_status(args):
    validate_name(args.name)
    result = run([kind_command(), "get", "clusters"], capture=True)
    clusters = result.stdout.splitlines()
    if args.name in clusters:
        print(f"{args.name}: running")
        return 0
    print(f"{args.name}: absent")
    return 1


def command_kubeconfig(args):
    validate_name(args.name)
    result = run([kind_command(), "get", "kubeconfig", "--name", args.name],
                 capture=True)
    print(result.stdout, end="")


def command_load_image(args):
    validate_name(args.name)
    validate_images(args.image, args.allow_mutable_tags)
    run([kind_command(), "load", "docker-image", *args.image,
         "--name", args.name])


def command_down(args):
    validate_name(args.name)
    run([kind_command(), "delete", "cluster", "--name", args.name])


def main():
    parser = argparse.ArgumentParser(
        description="render and invoke the standard Kind cluster lifecycle")
    commands = parser.add_subparsers(dest="command", required=True)

    render = commands.add_parser("render", help="render standard Kind YAML")
    render.add_argument("config", help="resolved uib-sim JSON configuration")
    render.set_defaults(handler=command_render)

    up = commands.add_parser("up", help="create one named Kind cluster")
    up.add_argument("config", help="resolved uib-sim JSON configuration")
    up.add_argument("--name", required=True, help="owned Kind cluster name")
    up.add_argument("--wait", default="120s", help="Kind readiness timeout")
    up.add_argument("--kubeconfig", help="write kubeconfig to this path")
    up.add_argument("--retain", action="store_true",
                    help="ask Kind to retain nodes after create failure")
    up.set_defaults(handler=command_up)

    status = commands.add_parser("status", help="test whether a cluster exists")
    status.add_argument("--name", required=True)
    status.set_defaults(handler=command_status)

    kubeconfig = commands.add_parser(
        "kubeconfig", help="print the standard Kind kubeconfig")
    kubeconfig.add_argument("--name", required=True)
    kubeconfig.set_defaults(handler=command_kubeconfig)

    load_image = commands.add_parser(
        "load-image", help="load explicit host images into every Kind node")
    load_image.add_argument("--name", required=True)
    load_image.add_argument("--image", action="append", required=True,
                            help="image reference; repeatable")
    load_image.add_argument(
        "--allow-mutable-tags", action="store_true",
        help="allow local development tags instead of immutable digests")
    load_image.set_defaults(handler=command_load_image)

    down = commands.add_parser("down", help="delete one named Kind cluster")
    down.add_argument("--name", required=True)
    down.set_defaults(handler=command_down)

    args = parser.parse_args()
    try:
        result = args.handler(args)
        return result if result is not None else 0
    except KindError as error:
        print(f"uib-kind: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
