#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(CDPATH='' cd -- "$script_dir/../.." && pwd)
cache_dir=${DIAGNOSTIC_DOWNLOAD_CACHE:-$project_dir/simulation/.artifacts/downloads}

fetch()
{
	name=$1
	sha256=$2
	url=$3
	path=$cache_dir/$name

	if [ -f "$path" ]; then
		printf '%s  %s\n' "$sha256" "$path" | sha256sum -c - >/dev/null
		printf 'using cached %s\n' "$path"
		return
	fi

	tmp=$(mktemp "$cache_dir/.download.XXXXXX")
	trap 'rm -f -- "$tmp"' EXIT INT TERM
	curl -fL --retry 3 -o "$tmp" "$url"
	printf '%s  %s\n' "$sha256" "$tmp" | sha256sum -c - >/dev/null
	mv "$tmp" "$path"
	trap - EXIT INT TERM
}

mkdir -p "$cache_dir"
fetch \
	nccl-tests-2535da805b34e96d1dc08be66289be1a6d57f5ad.tar.gz \
	637249acb10d04e060ff6af7de66e0ca917743f98762b0517f5ddc1815221995 \
	https://github.com/NVIDIA/nccl-tests/archive/2535da805b34e96d1dc08be66289be1a6d57f5ad.tar.gz
fetch \
	cuda-samples-a4526d52290b667cbc46b4a9830fbaad35be1ec2.tar.gz \
	9bda45969c70116475edcb52949ec514ba7e294aa9ac61df9cd9a88cb6c555bf \
	https://github.com/NVIDIA/cuda-samples/archive/a4526d52290b667cbc46b4a9830fbaad35be1ec2.tar.gz
