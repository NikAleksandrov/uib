{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uib.example/schemas/simulation.schema.json",
  "title": "UIB cluster simulation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "infrastructure",
    "cluster",
    "container",
    "launcher",
    "nodes",
    "uib",
    "communication",
    "network",
    "storage"
  ],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,47}$"
    },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": {
          "enum": ["kind", "virtme", "libvirt", "existing"]
        },
        "kernel": { "type": "string", "minLength": 1 },
        "kubernetesContext": { "type": "string", "minLength": 1 },
        "allowExistingMutations": { "type": "boolean" }
      }
    },
    "libvirt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "pool", "networkMode", "baseImage", "baseImageSha256", "sshUser", "diagnosticImage"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "pool": { "$ref": "#/$defs/slurmName" },
        "networkMode": { "enum": ["bridge", "rootless"] },
        "sshPortBase": { "type": "integer", "minimum": 1024, "maximum": 65534 },
        "baseImage": { "type": "string", "pattern": "^https://\\S+$" },
        "baseImageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sshUser": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$" },
        "diagnosticImage": { "type": "string", "pattern": "^\\S+@sha256:[0-9a-f]{64}$" }
      }
    },
    "virtme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "networkMode", "sshPortBase", "extraKernelArguments"],
      "properties": {
        "mode": { "enum": ["kind", "multi-guest"] },
        "networkMode": { "enum": ["socket", "bridge"] },
        "bridgePrefix": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,5}$"
        },
        "sshPortBase": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65534
        },
        "extraKernelArguments": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "networkMode": { "const": "bridge" } },
            "required": ["networkMode"]
          },
          "then": { "required": ["bridgePrefix"] }
        }
      ]
    },
    "kubernetes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "podCIDR", "serviceCIDR", "disable"],
      "properties": {
        "distribution": { "enum": ["k3s"] },
        "podCIDR": { "$ref": "#/$defs/cidr" },
        "serviceCIDR": { "$ref": "#/$defs/cidr" },
        "disable": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["traefik", "servicelb", "local-storage", "metrics-server"]
          }
        }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manager"],
      "properties": {
        "manager": { "enum": ["kubernetes", "slurm"] },
        "version": { "type": "string", "minLength": 1 },
        "nodeImage": {
          "type": "string",
          "pattern": "^\\S+@sha256:[0-9a-f]{64}$"
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime"],
      "properties": {
        "runtime": { "enum": ["containerd", "enroot", "apptainer"] },
        "integration": { "enum": ["none", "pyxis"] }
      }
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["training", "inference"],
      "properties": {
        "training": { "enum": ["kubeflow", "jobset", "slurm"] },
        "inference": {
          "enum": ["kuberay", "vllm-multiprocessing", "slurm-ray"]
        }
      }
    },
    "slurm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partition", "timeLimit"],
      "properties": {
        "partition": { "$ref": "#/$defs/slurmName" },
        "account": { "$ref": "#/$defs/slurmName" },
        "qos": { "$ref": "#/$defs/slurmName" },
        "reservation": { "$ref": "#/$defs/slurmName" },
        "constraint": { "$ref": "#/$defs/slurmName" },
        "memory": { "$ref": "#/$defs/quantity" },
        "timeLimit": {
          "type": "string",
          "pattern": "^(?:[0-9]+-)?(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
        },
        "rendezvousPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "exclusive": { "type": "boolean" }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlPlane", "workers", "cpu", "memory", "disk", "gpus"],
      "properties": {
        "controlPlane": { "type": "integer", "minimum": 0, "maximum": 9 },
        "workers": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "cpu": { "type": "integer", "minimum": 1 },
        "memory": { "$ref": "#/$defs/quantity" },
        "disk": { "$ref": "#/$defs/quantity" },
        "gpus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vendor", "perWorker"],
          "properties": {
            "vendor": { "enum": ["none", "nvidia", "amd"] },
            "perWorker": { "type": "integer", "minimum": 0, "maximum": 64 },
            "resourceName": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "uib": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "protocol", "bindPort", "transport", "memoryMode", "congestionControl"],
      "properties": {
        "enabled": { "type": "boolean" },
        "bundle": { "type": "string", "minLength": 1 },
        "protocol": { "enum": ["rocev2", "uet"] },
        "bindPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "transport": {
          "enum": ["udp-sync", "udp-io-uring", "udp-zc-afxdp", "tcp-devmem"]
        },
        "memoryMode": { "enum": ["host-staged", "gpu-direct"] },
        "environment": {
          "type": "object",
          "propertyNames": { "pattern": "^UIB_[A-Z0-9_]+$" },
          "additionalProperties": { "type": ["string", "integer", "boolean"] }
        },
        "congestionControl": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "abi", "parameters"],
          "properties": {
            "algorithm": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
            "abi": { "const": 1 },
            "parameters": {
              "type": "object",
              "additionalProperties": { "type": ["string", "integer", "number", "boolean"] }
            }
          }
        }
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontend", "fallbackPolicy"],
      "properties": {
        "frontend": { "enum": ["nccl", "rccl", "ucx", "libfabric"] },
        "fallbackPolicy": { "const": "fail" },
        "transportAllowlist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "nccl": { "$ref": "#/$defs/collective" },
        "rccl": { "$ref": "#/$defs/collective" },
        "ucx": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": { "type": "string" },
            "device": { "type": "string" },
            "transports": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string" }
            }
          }
        },
        "libfabric": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": { "type": "string" },
            "provider": { "enum": ["verbs", "verbs;ofi_rxd"] }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topology", "mtu", "shaping"],
      "properties": {
        "topology": { "enum": ["pairwise", "full-mesh", "leaf-spine", "physical"] },
        "managementCIDR": { "$ref": "#/$defs/cidr" },
        "dataCIDR": { "$ref": "#/$defs/cidr" },
        "dataInterface": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,15}$" },
        "mtu": { "type": "integer", "minimum": 576, "maximum": 65535 },
        "shaping": { "$ref": "#/$defs/shaping" },
        "endpointShaping": {
          "type": "object",
          "propertyNames": {
            "pattern": "^worker-[0-9]{2,4}/data$"
          },
          "additionalProperties": { "$ref": "#/$defs/shaping" }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelCacheClaim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?$"
        },
        "modelCacheImage": {
          "type": "string",
          "minLength": 1
        },
        "resultsClaim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?$"
        },
        "uibRuntimePath": { "$ref": "#/$defs/hostPath" },
        "modelCachePath": { "$ref": "#/$defs/hostPath" },
        "resultsPath": { "$ref": "#/$defs/hostPath" }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "image", "entrypoint", "parallelism"],
      "properties": {
        "kind": { "enum": ["collectives", "training", "inference"] },
        "image": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string", "minLength": 1 },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "model": { "$ref": "#/$defs/artifact" },
        "dataset": { "$ref": "#/$defs/artifact" },
        "parallelism": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nodes", "processesPerNode", "data", "tensor", "pipeline", "expert"],
          "properties": {
            "nodes": { "type": "integer", "minimum": 1 },
            "processesPerNode": { "type": "integer", "minimum": 1 },
            "data": { "type": "integer", "minimum": 1 },
            "tensor": { "type": "integer", "minimum": 1 },
            "pipeline": { "type": "integer", "minimum": 1 },
            "expert": { "type": "integer", "minimum": 1 }
          }
        },
        "parameters": { "type": "object" }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "integer", "minimum": 0 },
        "warmupSteps": { "type": "integer", "minimum": 0 },
        "steps": { "type": "integer", "minimum": 1 }
      }
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action"],
        "properties": {
          "at": { "$ref": "#/$defs/timeOffset" },
          "afterEvent": { "type": "string", "minLength": 1 },
          "action": {
            "enum": ["add-delay", "packet-loss", "link-down", "partition", "terminate-rank"]
          },
          "target": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 0 },
          "latency": { "$ref": "#/$defs/duration" },
          "percent": { "$ref": "#/$defs/percent" },
          "duration": { "$ref": "#/$defs/timeOffset" }
        },
        "oneOf": [
          { "required": ["at"] },
          { "required": ["afterEvent"] }
        ]
      }
    }
  },
  "$defs": {
    "quantity": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$" },
    "duration": { "type": "string", "pattern": "^[0-9]+(ns|us|ms|s)$" },
    "timeOffset": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
    "rate": { "type": "string", "pattern": "^[1-9][0-9]*(k|K|m|M|g|G)bit$" },
    "percent": { "type": "number", "minimum": 0, "maximum": 100 },
    "shaping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "bandwidth": { "$ref": "#/$defs/rate" },
        "latency": { "$ref": "#/$defs/duration" },
        "jitter": { "$ref": "#/$defs/duration" },
        "delayCorrelationPercent": { "$ref": "#/$defs/percent" },
        "delayDistribution": {
          "enum": ["uniform", "normal", "pareto", "paretonormal"]
        },
        "lossModel": { "enum": ["random", "gemodel"] },
        "lossPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "lossCorrelationPercent": { "$ref": "#/$defs/percent" },
        "lossRecoveryPercent": { "$ref": "#/$defs/percent" },
        "lossBadStatePercent": { "$ref": "#/$defs/percent" },
        "lossGoodStatePercent": { "$ref": "#/$defs/percent" },
        "duplicatePercent": { "$ref": "#/$defs/percent" },
        "duplicateCorrelationPercent": { "$ref": "#/$defs/percent" },
        "corruptPercent": { "$ref": "#/$defs/percent" },
        "corruptCorrelationPercent": { "$ref": "#/$defs/percent" },
        "reorderPercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "reorderCorrelationPercent": { "$ref": "#/$defs/percent" },
        "reorderGap": { "type": "integer", "minimum": 1 },
        "queueLimit": { "type": "integer", "minimum": 1 },
        "packetOverheadBytes": { "type": "integer", "minimum": -128, "maximum": 512 },
        "cellSizeBytes": { "type": "integer", "minimum": 1 },
        "cellOverheadBytes": { "type": "integer", "minimum": -128, "maximum": 512 },
        "ecn": { "type": "boolean" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "slurmName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "hostPath": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9._+@=-]+(?:/[A-Za-z0-9._+@=-]+)*$"
    },
    "cidr": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "collective": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "network": { "const": "IB" },
        "hca": { "type": "string", "minLength": 1 },
        "environment": {
          "type": "object",
          "propertyNames": { "pattern": "^(NCCL|RCCL)_[A-Z0-9_]+$" },
          "additionalProperties": { "type": ["string", "integer", "boolean"] }
        }
      }
    }
  }
}
