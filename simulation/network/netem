#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
set -eu

netem_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
. "$netem_dir/netem_lib/common.sh"
. "$netem_dir/netem_lib/command.sh"

tc_command=${NETEM_TC:-}
if [ -z "$tc_command" ]; then
	tc_command=$(command -v tc || true)
fi
if [ -z "$tc_command" ] && [ -x /sbin/tc ]; then
	tc_command=/sbin/tc
fi
if [ -z "$tc_command" ]; then
	echo "tc was not found; set NETEM_TC to its path" >&2
	exit 1
fi

action=${1:-}
case $action in
render|apply)
	[ "$#" -ge 3 ] || { usage; exit 2; }
	config=$2
	interface=$3
	target=
	replace_existing=false
	shift 3
	while [ "$#" -gt 0 ]; do
		case $1 in
		--target)
			[ "$#" -ge 2 ] || { usage; exit 2; }
			target=$2
			shift 2
			;;
		--replace-existing)
			replace_existing=true
			shift
			;;
		*) usage; exit 2 ;;
		esac
	done
	valid_interface "$interface" || {
		echo "invalid network interface: $interface" >&2
		exit 2
	}
	if [ -n "$target" ]; then
		case $target in
		worker-[0-9][0-9]/data|worker-[0-9][0-9][0-9]/data|\
		worker-[0-9][0-9][0-9][0-9]/data) ;;
		*) echo "invalid network target: $target" >&2; exit 2 ;;
		esac
	fi
	shaping=$(jq -ce --arg target "$target" '
		if $target == "" then .network.shaping
		else .network.endpointShaping[$target] // .network.shaping end |
		select(.enabled | type == "boolean")' "$config")
	netem_seed_supported=true
	if [ "$action" = apply ] &&
	   [ -n "$(jq -r '.seed // empty' <<<"$shaping")" ] &&
	   ! "$tc_command" qdisc add dev "$interface" root netem help 2>&1 | \
		grep -Eq '(^|[[:space:]])seed([[:space:]]|$)'; then
		netem_seed_supported=false
		echo "warning: target netem has no seed support; omitting seed" >&2
	fi
	build_command "$interface"
	print_command
	if [ "$action" = render ]; then
		exit 0
	fi
	if [ "$shaping_enabled" != true ]; then
		clear_netem "$interface"
		exit 0
	fi
	existing=$(root_qdisc "$interface")
	if [ -n "$existing" ] && [ "$existing" != netem ] && \
	   [ "$existing" != noqueue ] && [ "$replace_existing" != true ]; then
		echo "refusing to replace root qdisc '$existing' on $interface" >&2
		exit 1
	fi
	"${command[@]}"
	;;
clear)
	[ "$#" -eq 2 ] || { usage; exit 2; }
	valid_interface "$2" || { echo "invalid network interface: $2" >&2; exit 2; }
	clear_netem "$2"
	;;
show)
	[ "$#" -eq 2 ] || { usage; exit 2; }
	valid_interface "$2" || { echo "invalid network interface: $2" >&2; exit 2; }
	"$tc_command" -s qdisc show dev "$2"
	;;
*)
	usage
	exit 2
	;;
esac
