# SPDX-License-Identifier: Apache-2.0

import argparse
import copy
import json
import os
import pathlib
import re
import signal
import subprocess
import sys
import tempfile
import time


SIMULATION = pathlib.Path(__file__).resolve().parents[1]
DEFAULT_NETEM = SIMULATION / "network" / "netem"
INTERFACE = re.compile(r"^[A-Za-z0-9_.:@-]{1,32}$")
OFFSET = re.compile(r"^([0-9]+)(ms|s|m|h)$")
NETWORK_ACTIONS = {"add-delay", "packet-loss", "link-down", "partition"}


class ScheduleError(Exception):
    pass


def load_config(path):
    try:
        with pathlib.Path(path).open(encoding="utf-8") as source:
            config = json.load(source)
    except (OSError, json.JSONDecodeError) as error:
        raise ScheduleError(f"cannot load configuration: {error}") from error
    if not isinstance(config, dict) or not isinstance(config.get("network"), dict):
        raise ScheduleError("configuration has no network settings")
    if not isinstance(config.get("faults", []), list):
        raise ScheduleError("configuration faults must be a list")
    return config


def seconds(value):
    match = OFFSET.fullmatch(value)
    if not match:
        raise ScheduleError(f"invalid time offset: {value}")
    amount = int(match.group(1))
    unit = match.group(2)
    return amount * {
        "ms": 0.001,
        "s": 1,
        "m": 60,
        "h": 3600,
    }[unit]


def effective_config(config, active):
    effective = copy.deepcopy(config)
    shaping = copy.deepcopy(config["network"]["shaping"])

    partitioned = False
    for _, fault in sorted(active.items()):
        if fault["action"] == "add-delay":
            shaping["enabled"] = True
            shaping["latency"] = fault["latency"]
        elif fault["action"] == "packet-loss":
            shaping["enabled"] = True
            shaping["lossModel"] = "random"
            shaping["lossPercent"] = fault["percent"]
            for name in (
                    "lossCorrelationPercent", "lossRecoveryPercent",
                    "lossBadStatePercent", "lossGoodStatePercent"):
                shaping.pop(name, None)
        elif fault["action"] == "partition":
            partitioned = True
    if partitioned:
        shaping["enabled"] = True
        shaping["lossModel"] = "random"
        shaping["lossPercent"] = 100
        for name in (
                "lossCorrelationPercent", "lossRecoveryPercent",
                "lossBadStatePercent", "lossGoodStatePercent"):
            shaping.pop(name, None)
    effective["network"]["shaping"] = shaping
    return effective


def invoke(command, privilege_command=None):
    if privilege_command:
        command = [privilege_command, "-n", *command]
    completed = subprocess.run(command, text=True, capture_output=True,
                               check=False)
    return {
        "argv": command,
        "exitCode": completed.returncode,
        "stdout": completed.stdout,
        "stderr": completed.stderr,
    }


def apply_shaping(config, interface, netem, privilege_command):
    descriptor, name = tempfile.mkstemp(prefix="uib-fault-", suffix=".json")
    path = pathlib.Path(name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            json.dump(config, output, sort_keys=True)
            output.write("\n")
        result = invoke(
            [netem, "apply", str(path), interface, "--replace-existing"],
            privilege_command)
        result["shaping"] = config["network"]["shaping"]
        return result
    finally:
        path.unlink(missing_ok=True)


def append_record(output, record):
    output.write(json.dumps(record, sort_keys=True) + "\n")
    output.flush()


def run_schedule(config, target, interface, output, netem, ip_command,
                 privilege_command=None):
    config = copy.deepcopy(config)
    endpoint_shaping = config["network"].get("endpointShaping", {})
    config["network"]["shaping"] = copy.deepcopy(
        endpoint_shaping.get(target, config["network"]["shaping"]))
    events = []
    selected = 0

    for index, fault in enumerate(config.get("faults", [])):
        if fault["action"] not in NETWORK_ACTIONS or fault.get("target") != target:
            continue
        if "afterEvent" in fault:
            raise ScheduleError(
                f"faults[{index}] is event-relative; use a backend event executor")
        start = seconds(fault["at"])
        duration = seconds(fault["duration"])
        events.append((start, 1, index, "apply", fault))
        events.append((start + duration, 0, index, "recover", fault))
        selected += 1
    if not selected:
        raise ScheduleError(f"no time-relative network faults target {target}")

    active = {}
    link_down = False
    completed = False
    began = time.monotonic()
    try:
        for planned, _, index, phase, fault in sorted(events):
            remaining = began + planned - time.monotonic()
            if remaining > 0:
                time.sleep(remaining)
            if phase == "apply":
                active[index] = fault
            else:
                active.pop(index, None)

            was_down = link_down
            link_down = any(item["action"] == "link-down"
                            for item in active.values())
            commands = []
            if link_down and not was_down:
                commands.append(invoke(
                    [ip_command, "link", "set", "dev", interface, "down"],
                    privilege_command))
            elif was_down and not link_down:
                commands.append(invoke(
                    [ip_command, "link", "set", "dev", interface, "up"],
                    privilege_command))
                commands.append(apply_shaping(
                    effective_config(config, active), interface, netem,
                    privilege_command))
            elif not link_down:
                commands.append(apply_shaping(
                    effective_config(config, active), interface, netem,
                    privilege_command))

            failed = any(command["exitCode"] for command in commands)
            append_record(output, {
                "schemaVersion": 1,
                "sourceIndex": index,
                "phase": phase,
                "action": fault["action"],
                "target": target,
                "interface": interface,
                "plannedOffsetSeconds": planned,
                "actualOffsetSeconds": time.monotonic() - began,
                "activeFaults": sorted(active),
                "commands": commands,
                "result": "failed" if failed else "applied",
            })
            if failed:
                raise ScheduleError(f"faults[{index}] {phase} command failed")
        completed = True
    finally:
        if not completed:
            commands = []
            if link_down:
                commands.append(invoke(
                    [ip_command, "link", "set", "dev", interface, "up"],
                    privilege_command))
            commands.append(apply_shaping(
                config, interface, netem, privilege_command))
            cleanup_failed = any(command["exitCode"] for command in commands)
            append_record(output, {
                "schemaVersion": 1,
                "phase": "cleanup",
                "action": "restore-network",
                "target": target,
                "interface": interface,
                "actualOffsetSeconds": time.monotonic() - began,
                "activeFaults": sorted(active),
                "commands": commands,
                "result": "failed" if cleanup_failed else "restored",
            })


def interrupted(signum, unused):
    raise ScheduleError(f"interrupted by signal {signum}")


def main():
    parser = argparse.ArgumentParser(
        description="apply time-relative network faults to one endpoint")
    parser.add_argument("config", help="resolved uib-sim JSON")
    parser.add_argument("--target", required=True,
                        help="logical fault target selected from the request")
    parser.add_argument("--interface", required=True,
                        help="interface represented by the logical target")
    parser.add_argument("--output", required=True,
                        help="new JSONL evidence file")
    parser.add_argument("--netem", default=os.environ.get(
                            "FAULT_NETEM", str(DEFAULT_NETEM)),
                        help="netem adapter executable")
    parser.add_argument("--ip-command", default=os.environ.get(
                            "FAULT_IP", "ip"),
                        help="ip executable")
    parser.add_argument("--privilege-command",
                        help="noninteractive sudo-compatible executable")
    args = parser.parse_args()
    output_path = pathlib.Path(args.output)
    try:
        signal.signal(signal.SIGINT, interrupted)
        signal.signal(signal.SIGTERM, interrupted)
        if not INTERFACE.fullmatch(args.interface):
            raise ScheduleError(f"invalid interface: {args.interface}")
        output_path.parent.mkdir(parents=True, exist_ok=True)
        with output_path.open("x", encoding="utf-8") as output:
            run_schedule(
                load_config(args.config), args.target, args.interface, output,
                args.netem, args.ip_command, args.privilege_command,
            )
    except (OSError, ScheduleError) as error:
        print(f"network-schedule: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
